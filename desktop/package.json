{
  "name": "printease-desktop",
  "version": "1.0.0",
  "description": "PrintEase Windows Desktop Agent & Print Spooler",
  "main": "src/main.js",
  "author": "PrintEase Team",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "dist": "electron-builder --win",
    "dist:dir": "electron-builder --win --dir"
  },
  "build": {
    "appId": "com.printease.desktop",
    "productName": "PrintEase Desktop Agent",
    "copyright": "Copyright © 2026 PrintEase",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PrintEase Desktop Agent",
      "artifactName": "PrintEase-Setup-${version}.${ext}"
    }
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^26.18.0"
  }
}
